#!/bin/bash
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# https://mds.sk87.top/install-vlmcsd
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
set -euo pipefail
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if ! command -v curl >/dev/null 2>&1; then
    apt-get update -qq && apt-get install -y curl >/dev/null
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if [[ "${DEB_LIB_STATUS:-}" != "loaded" ]] || ! declare -f color_text >/dev/null 2>&1; then
    if source <(curl -sLf https://mds.sk87.top/lib); then
        export DEB_LIB_STATUS="loaded"
    else
        echo -e "ERROR: not loaded lib" >&2
        exit 1
    fi
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
module_init "install-vlmcsd" "$CYAN"
check_update
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

color_text "$COLOR_SCRIPT" "==>>==>>==>> [INSTALL-VLMCSD] ->->-> Building and installing vlmcsd..."

# --- 1. Install build deps ---
color_text "$COLOR_SCRIPT" "[DEPS] -> installing build dependencies:"
apt-get install -y git build-essential debhelper fakeroot

# --- 2. Clone and build ---
BUILD_DIR=$(mktemp -d -t "vlmcsd-build-XXXXXXXXXX")
color_text "$COLOR_SCRIPT" "[BUILD] -> cloning vlmcsd to $BUILD_DIR..."

git clone https://github.com/Wind4/vlmcsd "$BUILD_DIR/vlmcsd"

(
    cd "$BUILD_DIR/vlmcsd"
    git submodule update --init debian
    color_text "$COLOR_SCRIPT" "[BUILD] -> building .deb package..."
    dpkg-buildpackage -rfakeroot -D -us -uc
)

# --- 3. Install built package ---
color_text "$COLOR_SCRIPT" "[INSTALL] -> installing vlmcsd .deb package:"
DEB_FILE=$(find "$BUILD_DIR" -maxdepth 1 -name "vlmcsd_*.deb" | head -n1)
if [[ -z "$DEB_FILE" ]]; then
    color_text "$RED" "[!] .deb package not found in $BUILD_DIR"
    rm -rf "$BUILD_DIR"
    exit 1
fi
dpkg -i "$DEB_FILE"

# --- 4. Cleanup ---
color_text "$COLOR_SCRIPT" "[CLEANUP] -> removing build directory:"
rm -rf "$BUILD_DIR"

# --- 5. Verify ---
if command -v vlmcsd >/dev/null 2>&1; then
    vlmcsd -V 2>/dev/null || true
fi

color_text "$GREEN" "==>>==>>==>> [INSTALL-VLMCSD][✓] ->->-> vlmcsd installed successfully!"
