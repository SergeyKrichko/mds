#!/bin/bash
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# https://mds.sk87.top/install-wireguard
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
set -euo pipefail
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if ! command -v curl >/dev/null 2>&1; then
    apt-get update -qq && apt-get install -y curl >/dev/null
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if [[ "${DEB_LIB_STATUS:-}" != "loaded" ]] || ! declare -f color_text >/dev/null 2>&1; then
    if source <(curl -sLf https://mds.sk87.top/lib); then
        export DEB_LIB_STATUS="loaded"
    else
        echo -e "ERROR: not loaded lib" >&2
        exit 1
    fi
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
module_init "install-wireguard" "$CYAN"
check_update
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

color_text "$COLOR_SCRIPT" "==>>==>>==>> [INSTALL-WIREGUARD] ->->-> Installing WireGuard..."

# --- 1. Install ---
color_text "$COLOR_SCRIPT" "[INSTALL] -> installing wireguard packages:"
apt-get install -y wireguard wireguard-tools

# --- 2. Generate keys ---
color_text "$COLOR_SCRIPT" "[KEYS] -> generating server keypair:"
wg genkey | tee /etc/wireguard/wg0.privatekey | wg pubkey > /etc/wireguard/wg0.publickey
chmod 600 /etc/wireguard/wg0.privatekey /etc/wireguard/wg0.publickey

read -r WG0PRIVATEKEY < /etc/wireguard/wg0.privatekey
read -r WG0PUBLICKEY  < /etc/wireguard/wg0.publickey

color_text "$COLOR_SCRIPT" "Private key: (saved to /etc/wireguard/wg0.privatekey)"
color_text "$GREEN" "Public key:  $WG0PUBLICKEY"

# --- 3. Collect configuration ---
input_step "WireGuard ListenPort" "LISTENPORT" "PORT" || exit 0
input_step "WireGuard Address (e.g. 10.0.0.1/24)" "ADDRESS" "ANY" || exit 0

# --- 4. Write wg0.conf ---
color_text "$COLOR_SCRIPT" "[CONFIG] -> writing /etc/wireguard/wg0.conf..."
cat > /etc/wireguard/wg0.conf <<EOF
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# mds-wg0 — auto-generated by install-wireguard
# Sergey Krichko
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
[Interface]
PrivateKey = $WG0PRIVATEKEY
#PublicKey = $WG0PUBLICKEY
ListenPort = $LISTENPORT
Address = $ADDRESS
#PostUp =
#PostDown =
SaveConfig = true
EOF

chmod 600 /etc/wireguard/wg0.conf

# --- 5. Enable IP forwarding ---
color_text "$COLOR_SCRIPT" "[SYSCTL] -> enabling IP forwarding:"
if ! grep -q "^net.ipv4.ip_forward=1" /etc/sysctl.conf; then
    echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
fi
sysctl -p

# --- 6. Enable and start ---
color_text "$COLOR_SCRIPT" "[SERVICE] -> enabling wg0:"
systemctl enable --now wg-quick@wg0

# --- 7. Result ---
wg show wg0 2>/dev/null || true
color_text "$GREEN" "==>>==>>==>> [INSTALL-WIREGUARD][✓] ->->-> WireGuard installed successfully!"
color_text "$YELLOW" "[i] Public key: $WG0PUBLICKEY"
color_text "$YELLOW" "[i] ListenPort: $LISTENPORT | Address: $ADDRESS"