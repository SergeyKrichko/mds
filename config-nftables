#!/bin/bash
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# https://mds.sk87.top/config-nftables
# Sergey Krichko
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
set -euo pipefail
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if ! command -v curl >/dev/null 2>&1; then
    apt-get update -qq && apt-get install -y curl >/dev/null
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if [[ "${DEB_LIB_STATUS:-}" != "loaded" ]] || ! declare -f color_text >/dev/null 2>&1; then
    if source <(curl -sLf https://mds.sk87.top/lib); then
        export DEB_LIB_STATUS="loaded"
    else
        echo -e "ERROR: not loaded lib" >&2
        exit 1
    fi
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
module_init "config-nftables" "$GREEN"
check_update
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

color_text "$COLOR_SCRIPT" "==>>==>>==>> [CONFIG-NFTABLES] ->->-> Configuration..."

# --- 1. Install nftables ---
install_pkg "nft" "nftables"

# --- 2. Create directories ---
mkdir -p /etc/nftables-rule
mkdir -p /etc/nftables-enabled

# --- 3. Ask for SSH port ---
input_step "SSH port for firewall" "SSH_PORT" "PORT" || exit 0

# --- 4. Ask about ICMP ---
color_text -n "$COLOR_SCRIPT" "Allow ICMP (ping)? [Y/n]: "
read -n 1 -r ICMP_ANSWER < /dev/tty
echo ""
ENABLE_ICMP=false
[[ "$ICMP_ANSWER" =~ ^[Yy]$ || -z "$ICMP_ANSWER" ]] && ENABLE_ICMP=true

# --- 5. Ask about WireGuard ---
ENABLE_WG=false
WG_PORT=""
WG_IFACE=""
color_text -n "$COLOR_SCRIPT" "Configure WireGuard NAT rules? [y/N]: "
read -n 1 -r WG_ANSWER < /dev/tty
echo ""
if [[ "$WG_ANSWER" =~ ^[Yy]$ ]]; then
    ENABLE_WG=true
    input_step "WireGuard listen port" "WG_PORT" "PORT" || exit 0
    # Detect external interface
    EXT_IFACE=$(ip -o -4 route show to default | awk '{print $5}' | head -n1)
    color_text "$COLOR_SCRIPT" "External interface detected: ${EXT_IFACE:-none}"
    input_step "External interface for WG NAT [default: $EXT_IFACE]" "WG_IFACE" "ANY" || WG_IFACE="$EXT_IFACE"
    [[ -z "$WG_IFACE" ]] && WG_IFACE="$EXT_IFACE"
fi

# --- 6. Write main nftables.conf ---
color_text "$COLOR_SCRIPT" "==>>==>>==>> [CONFIG-NFTABLES] ->->-> Writing /etc/nftables.conf..."

cat > /etc/nftables.conf <<'NFTEOF'
#!/usr/sbin/nft -f
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# mds-nftables — auto-generated by config-nftables
# Sergey Krichko
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
flush ruleset

table inet main {
    chain main_input {
        type filter hook input priority 0; policy drop;
        iif "lo" accept
        ct state established,related accept
        log prefix "nft INPUT DROP: " flags all counter
        include "/etc/nftables-enabled/*.nftmaininput"
    }

    chain main_output {
        type filter hook output priority 0; policy accept;
        include "/etc/nftables-enabled/*.nftmainoutput"
    }

    chain main_forward {
        type filter hook forward priority 0; policy drop;
        include "/etc/nftables-enabled/*.nftmainforward"
    }
}

table ip nat {
    chain nat_prerouting {
        type nat hook prerouting priority dstnat;
        include "/etc/nftables-enabled/*.nftnatprerouting"
    }

    chain nat_postrouting {
        type nat hook postrouting priority srcnat;
        include "/etc/nftables-enabled/*.nftnatpostrouting"
    }
}

include "/etc/nftables-enabled/*.nftaddrule"
NFTEOF

# --- 7. Write SSH rule ---
color_text "$COLOR_SCRIPT" "==>>==>>==>> [CONFIG-NFTABLES] ->->-> Writing SSH rule (port $SSH_PORT)..."
cat > /etc/nftables-rule/ssh.nftaddrule <<EOF
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# mds-nftables-ssh — auto-generated
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
add rule inet main main_input tcp dport {$SSH_PORT} accept
EOF
ln -sf /etc/nftables-rule/ssh.nftaddrule /etc/nftables-enabled/ssh.nftaddrule

# --- 8. Write ICMP rule (optional) ---
if [[ "$ENABLE_ICMP" == "true" ]]; then
    color_text "$COLOR_SCRIPT" "==>>==>>==>> [CONFIG-NFTABLES] ->->-> Writing ICMP rule..."
    cat > /etc/nftables-rule/icmp.nftaddrule <<'EOF'
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# mds-nftables-icmp — auto-generated
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
add rule inet main main_input ip protocol icmp accept
add rule inet main main_input ip6 nexthdr icmpv6 accept
EOF
    ln -sf /etc/nftables-rule/icmp.nftaddrule /etc/nftables-enabled/icmp.nftaddrule
fi

# --- 9. Write WireGuard rule (optional) ---
if [[ "$ENABLE_WG" == "true" ]]; then
    color_text "$COLOR_SCRIPT" "==>>==>>==>> [CONFIG-NFTABLES] ->->-> Writing WireGuard rule (port $WG_PORT, iface $WG_IFACE)..."
    cat > /etc/nftables-rule/wg0.nftaddrule <<EOF
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# mds-nftables-wg0 — auto-generated
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
add rule inet main main_input iifname "$WG_IFACE" udp dport {$WG_PORT} accept
add rule inet main main_forward iifname "wg0" oifname "$WG_IFACE" accept
add rule inet main main_forward ct state established,related accept
add rule ip nat nat_postrouting oifname "$WG_IFACE" masquerade
EOF
    ln -sf /etc/nftables-rule/wg0.nftaddrule /etc/nftables-enabled/wg0.nftaddrule
fi

# --- 10. Validate and apply ---
color_text "$COLOR_SCRIPT" "==>>==>>==>> [CONFIG-NFTABLES] ->->-> Validating config..."
if nft -c -f /etc/nftables.conf; then
    color_text "$GREEN" "[✓] Config is valid. Applying..."
    nft -f /etc/nftables.conf
    systemctl enable nftables
    color_text "$GREEN" "==>>==>>==>> [CONFIG-NFTABLES][✓] ->->-> Configuration applied!"
    echo ""
    color_text "$COLOR_SCRIPT" "Current ruleset:"
    nft -a list ruleset
else
    color_text "$RED" "[!] Config validation FAILED. Not applied."
    exit 1
fi