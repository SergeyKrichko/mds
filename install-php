#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
set -euo pipefail
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if [[ -z "${1:-}" ]]; then
    echo "Ошибка: не указана версия PHP. Использование: $0 <версия>" >&2
    echo "Пример: $0 8.5" >&2
    exit 1
fi
PHP_VER=$1
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if ! command -v curl >/dev/null 2>&1; then
    apt-get update -qq && apt-get install -y curl >/dev/null
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if [[ "${DEB_LIB_STATUS:-}" != "loaded" ]] || ! declare -f color_text >/dev/null 2>&1; then
    if source <(curl -sLf https://mds.sk87.top/lib); then
        export DEB_LIB_STATUS="loaded"
    else
        echo -e "ERROR: not loaded lib" >&2
        exit 1
    fi
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
module_init "install-php" "$CYAN"
check_update
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
. /etc/os-release

color_text "$COLOR_SCRIPT" "==>>==>>==>> [INSTALL-PHP] ->->-> Installing PHP $PHP_VER (https://packages.sury.org/php/)..."

# --- 1. Dependencies ---
color_text "$COLOR_SCRIPT" "[SOFT] -> install dependencies:"
apt-get install -y curl ca-certificates apt-transport-https

# --- 2. GPG key ---
color_text "$COLOR_SCRIPT" "[GPG] -> add sury GPG key:"
curl -sSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb
dpkg -i /tmp/debsuryorg-archive-keyring.deb

# --- 3. Repository ---
color_text "$COLOR_SCRIPT" "[REPO] -> add PHP repository:"
tee /etc/apt/sources.list.d/php.sources > /dev/null <<EOF
Types: deb
URIs: https://packages.sury.org/php/
Suites: ${VERSION_CODENAME}
Architectures: amd64
Components: main
Signed-By: /usr/share/keyrings/debsuryorg-archive-keyring.gpg
EOF

apt-get update -y

# --- 4. Create php user (LXC UID mapping) ---
if ! getent group php >/dev/null; then
    groupadd -g 331 php
fi
if ! getent passwd php >/dev/null; then
    useradd -u 331 -g 331 --system --no-create-home -s /usr/sbin/nologin php
fi

# --- 5. Install PHP ---
color_text "$COLOR_SCRIPT" "[INSTALL] -> PHP core:"
apt-get install -y php${PHP_VER}-cli php${PHP_VER}-fpm php${PHP_VER}-common

color_text "$COLOR_SCRIPT" "[INSTALL] -> PHP modules (Required):"
apt-get install -y php${PHP_VER}-curl php${PHP_VER}-xml php${PHP_VER}-gd php${PHP_VER}-mbstring php${PHP_VER}-zip

color_text "$COLOR_SCRIPT" "[INSTALL] -> PHP modules (Recommended):"
apt-get install -y php${PHP_VER}-apcu redis-server php${PHP_VER}-redis php${PHP_VER}-intl

color_text "$COLOR_SCRIPT" "[INSTALL] -> PHP modules (Specific App):"
apt-get install -y php${PHP_VER}-ldap php${PHP_VER}-imap php${PHP_VER}-gmp php${PHP_VER}-imagick php${PHP_VER}-smbclient
apt-get install -y php${PHP_VER}-pgsql php${PHP_VER}-soap php${PHP_VER}-bcmath php${PHP_VER}-bz2

# --- 6. Result ---
color_text "$COLOR_SCRIPT" "Installed version:" && php -v
color_text "$GREEN" "==>>==>>==>> [INSTALL-PHP][✓] ->->-> PHP $PHP_VER installed successfully!"