#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
set -euo pipefail
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if ! command -v curl >/dev/null 2>&1; then
    apt-get update -qq && apt-get install -y curl >/dev/null
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
if [[ "${DEB_LIB_STATUS:-}" != "loaded" ]] || ! declare -f color_text >/dev/null 2>&1; then
    if source <(curl -sLf https://mds.sk87.top/lib); then
        export DEB_LIB_STATUS="loaded"
    else
        echo -e "ERROR: not loaded lib" >&2
        exit 1
    fi
fi
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
module_init "install-stack-LNPP" "$CYAN"
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
. /etc/os-release
BASE_URL="https://mds.sk87.top"

# --- Parse arguments ---
psqlversion=""
phpversion=""

while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        -ngx)
            shift
            ;;
        -psql)
            psqlversion="$2"
            shift 2
            ;;
        -php)
            phpversion="$2"
            shift 2
            ;;
        *)
            color_text "$RED" "Ошибка: неизвестный параметр $1"
            color_text "$RED" "Использование: $0 -ngx -psql <версия> -php <версия>"
            exit 1
            ;;
    esac
done

# --- Validate ---
[[ -z "$psqlversion" ]] && { color_text "$RED" "[!] Не указана версия PostgreSQL (-psql)"; exit 1; }
[[ -z "$phpversion" ]]  && { color_text "$RED" "[!] Не указана версия PHP (-php)"; exit 1; }

color_text "$COLOR_SCRIPT" "==>>==>>==>> [STACK-LNPP] ->->-> Installing stack..."
color_text "$COLOR_SCRIPT" "  NGINX:      latest stable"
color_text "$COLOR_SCRIPT" "  PostgreSQL: $psqlversion"
color_text "$COLOR_SCRIPT" "  PHP:        $phpversion"
sleep 2

# --- 1. Install NGINX ---
color_text "$COLOR_SCRIPT" "[1/3] -> Installing NGINX..."
bash <(curl -sLf "$BASE_URL/install-nginx")

# --- 2. Install PostgreSQL ---
color_text "$COLOR_SCRIPT" "[2/3] -> Installing PostgreSQL $psqlversion..."
bash <(curl -sLf "$BASE_URL/install-psql") "$psqlversion"

# --- 3. Install PHP ---
color_text "$COLOR_SCRIPT" "[3/3] -> Installing PHP $phpversion..."
bash <(curl -sLf "$BASE_URL/install-php") "$phpversion"

# --- Result ---
color_text "$GREEN" "==>>==>>==>> [STACK-LNPP][✓] ->->-> Stack installed successfully!"
color_text "$GREEN" "  NGINX + PostgreSQL $psqlversion + PHP $phpversion"